# =============================================================================
# Docker Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your deployment
# DO NOT commit the .env file to version control!

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection URL for the application
DB_URL=postgresql://postgres:postgres@postgres:5432/mydb

# SQLx requires DATABASE_URL for migrations
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mydb

# PostgreSQL database credentials (if using the bundled postgres service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydb

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
# JWT Secret - CHANGE THIS to a strong random string in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Origins - comma-separated list of allowed origins
# For production, set this to your actual frontend domain
CORS_ORIGINS=http://localhost:12000

# Logging level (trace, debug, info, warn, error)
RUST_LOG=tambahkan_ini_ke_database_my_api=info,tower_http=info

# -----------------------------------------------------------------------------
# Cloudflare R2 / S3 Storage Configuration
# -----------------------------------------------------------------------------
# Get these from your Cloudflare R2 dashboard
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_DOMAIN=https://your-public-domain.com
