# Stage 1: Build the frontend with Bun
FROM oven/bun:1-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json bun.lock ./

# Install dependencies using Bun
RUN bun install --frozen-lockfile

# Copy source code
COPY . .

# Build the application
RUN bun run build

# Stage 2: Serve with Bun
FROM oven/bun:1-alpine AS production

WORKDIR /app

# Install serve package globally with Bun
RUN bun add -g serve

# Copy built files from builder stage
# Note: Vite builds to api/dist by default (as per vite.config.ts)
COPY --from=builder /app/api/dist ./dist

# Expose port 12000
EXPOSE 12000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:12000 || exit 1

# Start Bun server to serve static files
# Using serve package for SPA routing support
CMD ["serve", "dist", "-l", "12000", "--single"]
