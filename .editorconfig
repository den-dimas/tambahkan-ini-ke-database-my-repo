root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
quote_type = single

[*.rs]
indent_size = 4
quote_type = double

[*.toml]
indent_size = 4

[*.{js,ts,jsx,tsx,vue,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false